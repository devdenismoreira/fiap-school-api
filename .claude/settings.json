{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn typecheck)",
      "Bash(yarn lint)",
      "Bash(yarn lint *)",
      "Bash(yarn test)",
      "Bash(yarn test *)",
      "Bash(yarn test:integration)",
      "Bash(yarn test:integration *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(yarn add *)",
      "Bash(yarn remove *)",
      "Bash(yarn upgrade *)",
      "Bash(docker compose *)",
      "Bash(docker *)",
      "Bash(yarn prisma *)",
      "Bash(npx prisma *)",
      "Bash(yarn db:*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(./.env)",
      "Read(./.env.test)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)"
    ]
  }
}
