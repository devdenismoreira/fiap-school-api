# Valores fictícios. Copie para .env (desenvolvimento) e .env.test (testes de integração).
# No .env.test, troque schema=fiap_school por schema=fiap_school_test nas duas URLs.

# Execução (T01)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco no Supabase (T01, D-26). Base das URLs em Connect > ORMs > Prisma no painel;
# troque ?pgbouncer=true pelos parâmetros abaixo. Na senha, codifique @ como %40 e # como %23.
# DATABASE_URL: pooler em modo transação (porta 6543), usado pela API, com o certificado validado.
# DIRECT_URL: pooler em modo sessão (porta 5432), usado pelas migrations.
DATABASE_URL=postgresql://postgres.REF_DO_PROJETO:SENHA_DO_BANCO@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?schema=fiap_school&sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
DIRECT_URL=postgresql://postgres.REF_DO_PROJETO:SENHA_DO_BANCO@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?schema=fiap_school&sslmode=require

# Autenticação e sessões (T03). JWT_PRIVATE_KEY, JWT_PUBLIC_KEY e CPF_HMAC_SECRET são
# gerados por `yarn keys:generate .env` (e `.env.test`), com um par por ambiente.
# Os demais têm padrão e só precisam aparecer para mudar o valor.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=fiap-school-api
JWT_AUDIENCE=fiap-school-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12
CPF_HMAC_SECRET=

# CORS e HTTPS (T04). Sem cliente web: CORS_ORIGINS vazio.
CORS_ORIGINS=
TRUST_PROXY=0
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Seed (T02)
SEED_SOURCE_PATH=../FiapSchoolMobile/src/data/datasources/local/responsaveis.json
