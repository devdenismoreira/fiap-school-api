{
  "testEnvironment": "node",
  "roots": ["<rootDir>/src", "<rootDir>/tests/support", "<rootDir>/scripts"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+/node_modules/jose/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "isolatedModules": true
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "clearMocks": true,
  "transformIgnorePatterns": ["/node_modules/(?!jose/)"]
}
