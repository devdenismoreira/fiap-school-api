{
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests/integration"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+/node_modules/jose/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "isolatedModules": true
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "globalSetup": "<rootDir>/tests/integration/globalSetup.ts",
  "testTimeout": 30000,
  "clearMocks": true,
  "transformIgnorePatterns": ["/node_modules/(?!jose/)"],
  "setupFilesAfterEnv": [
    "<rootDir>/tests/integration/setup/contractAssertions.ts"
  ]
}
